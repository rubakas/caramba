{
  "name": "@caramba/desktop",
  "description": "Caramba — personal media center",
  "author": "Vladyslav <vladyslav@hey.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "vite build && electron .",
    "dist": "vite build && electron-builder --mac --x64 --arm64 --publish never",
    "test": "node --test electron/**/*.test.js"
  },
  "build": {
    "appId": "com.cupatea.caramba",
    "productName": "Caramba",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "../ui/public/icon.icns",
      "extraResources": [
        {
          "from": "vendor/ffmpeg-${arch}",
          "to": "ffmpeg"
        },
        {
          "from": "vendor/vlc-${arch}/lib",
          "to": "vlc/lib"
        },
        {
          "from": "vendor/vlc-${arch}/plugins",
          "to": "vlc/plugins"
        },
        {
          "from": "vendor/vlc-${arch}/share",
          "to": "vlc/share"
        }
      ],
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "Caramba reads media files you place on your Desktop so it can play and transcode them.",
        "NSDocumentsFolderUsageDescription": "Caramba reads media files you place in Documents so it can play and transcode them.",
        "NSDownloadsFolderUsageDescription": "Caramba reads media files you place in Downloads so it can play and transcode them.",
        "NSRemovableVolumesUsageDescription": "Caramba reads media files from external drives so it can play and transcode them.",
        "NSNetworkVolumesUsageDescription": "Caramba reads media files from network shares so it can play and transcode them."
      }
    },
    "files": [
      "electron/**/*",
      "!electron/native/*/node_modules/**",
      "!electron/native/*/build/{config.gypi,*.mk,Makefile,obj.target/**,Release/.deps/**,Release/obj.target/**}",
      "dist-react/**/*",
      ".env"
    ],
    "asar": true,
    "asarUnpack": [
      "electron/native/vlc-embed/build/Release/*.node"
    ]
  },
  "dependencies": {
    "@caramba/ui": "workspace:*",
    "@sentry/electron": "^5.10.0",
    "better-sqlite3": "^11.0.0",
    "bonjour-service": "^1.3.0",
    "node-vlc-http": "^1.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@sentry/vite-plugin": "^2.22.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "react-router-dom": "^7.0.0",
    "vite": "^6.0.0"
  }
}
