{
  "name": "@caramba/desktop",
  "description": "Caramba — personal media center",
  "author": "Vladyslav <vladyslav@hey.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "vite build && electron .",
    "dist": "vite build && electron-builder --mac --x64 --arm64 --publish never",
    "test": "node --test electron/**/*.test.js"
  },
  "build": {
    "appId": "com.cupatea.caramba",
    "productName": "Caramba",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "../ui/public/icon.icns",
      "extraResources": [
        {
          "from": "vendor/vlc-${arch}/lib",
          "to": "vlc/lib"
        },
        {
          "from": "vendor/vlc-${arch}/plugins",
          "to": "vlc/plugins"
        },
        {
          "from": "vendor/vlc-${arch}/share",
          "to": "vlc/share"
        },
        {
          "from": "electron/native/vlc-embed/build/Release/vlc_embed.node",
          "to": "vlc-embed/vlc_embed.node"
        }
      ],
      "extendInfo": {
        "NSDownloadsFolderUsageDescription": "Caramba writes downloaded episodes and movies to your Downloads folder."
      }
    },
    "files": [
      "electron/**/*",
      "!electron/native/**",
      "dist-react/**/*",
      ".env"
    ],
    "asar": true
  },
  "dependencies": {
    "@caramba/ui": "workspace:*",
    "@opentelemetry/api-logs": "^0.207.0",
    "@sentry-internal/browser-utils": "^10.50.0",
    "@sentry-internal/feedback": "^10.50.0",
    "@sentry-internal/replay": "^10.50.0",
    "@sentry-internal/replay-canvas": "^10.50.0",
    "@sentry/browser": "^10.50.0",
    "@sentry/electron": "^7.13.0",
    "bonjour-service": "^1.3.0",
    "debug": "^4.4.3",
    "module-details-from-path": "^1.0.4",
    "ms": "^2.1.3",
    "node-vlc-http": "^1.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@sentry/vite-plugin": "^5.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.5.1",
    "electron-builder": "^26.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.0",
    "react-router-dom": "^7.15.0",
    "vite": "^8.0.11"
  }
}
