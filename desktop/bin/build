#!/usr/bin/env bash
#
# Build the packaged app with auto version increment.
#
# Version format: MAJOR.MINOR.PATCH where PATCH auto-increments.
# Version is stored in the root package.json.
#
# Usage: bin/build                        # Mac, no publish
#        bin/build --publish              # Mac + publish to GitHub
#
set -euo pipefail

cd "$(dirname "$0")/.."
ROOT_DIR="$(cd .. && pwd)"

ROOT_PACKAGE_JSON="$ROOT_DIR/package.json"

# ── Load .env.local (gitignored) for SENTRY_AUTH_TOKEN, SENTRY_ORG, etc. ────
if [ -f "$ROOT_DIR/.env.local" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$ROOT_DIR/.env.local"
  set +a
fi

# ── 0. Parse flags ──────────────────────────────────────────────────
PUBLISH=false

for arg in "$@"; do
  case "$arg" in
    --publish) PUBLISH=true ;;
    *) echo "Unknown flag: $arg (use --publish)"; exit 1 ;;
  esac
done

# ── 1. Pre-flight checks ───────────────────────────────────────────
# Ensure working directory is clean (uncommitted changes can cause confusion)
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
  echo "Warning: You have uncommitted changes. Build will use the current working tree state."
fi

# Install dependencies
echo "Installing dependencies..."
cd "$ROOT_DIR"
pnpm install
cd desktop

# Workaround: electron-builder looks for 'electron-rebuild' but pnpm installs as '@electron/rebuild'
if [ ! -e node_modules/electron-rebuild ]; then
  mkdir -p node_modules
  ln -sf ../../node_modules/@electron/rebuild node_modules/electron-rebuild
fi

# Workaround: under hoisted node-linker, deps live at workspace root; electron-builder
# still expects to find `electron` in the workspace's own node_modules.
if [ ! -e node_modules/electron ]; then
  mkdir -p node_modules
  ln -sf ../../node_modules/electron node_modules/electron
fi

# ── 2. Read version ─────────────────────────────────────────────────
# Version bumping is now owned by the root bin/build (which prompts for
# major/minor/patch when --publish is passed). Here we just read whatever
# package.json currently says and bake it into the build.
CURRENT_VERSION=$(node -e "console.log(require('$ROOT_PACKAGE_JSON').version)")
echo "Version: $CURRENT_VERSION"

# ── 3. Version for electron-builder ────────────────────────────────
# electron-builder needs version WITHOUT 'v' prefix
VERSION_NUM="${CURRENT_VERSION#v}"

# Export the release tag for @sentry/vite-plugin and the runtime.
FINAL_VERSION="${CURRENT_VERSION}"
export SENTRY_RELEASE="caramba@${FINAL_VERSION#v}"
echo "Sentry release: $SENTRY_RELEASE"

# ── 4. Build React frontend ────────────────────────────────────────
echo ""
echo "Building React frontend..."
pnpm exec vite build

# Always remove source maps from shipped artifacts — plugin only deletes them
# when auth token is set, but we never want maps inside the asar bundle.
find dist-react -name '*.js.map' -delete 2>/dev/null || true

# ── 5. Build macOS package ─────────────────────────────────────────
# No libVLC binaries to bundle — playback is the in-renderer Jellyfin
# Player JS runtime, and "Open in VLC" launches the user's installed
# VLC.app via electron/services/libvlc-player.js (external subprocess).
echo ""
echo "Building macOS app $CURRENT_VERSION..."
pnpm exec electron-builder --mac --publish never -c.extraMetadata.version="$VERSION_NUM"

# ── 6. Summary ─────────────────────────────────────────────────────
echo ""
echo "Build complete: $CURRENT_VERSION"
ls -lh dist/*.dmg 2>/dev/null || true

# ── 7. Publish to GitHub Releases ──────────────────────────────────
if $PUBLISH; then
  bin/publish

  echo ""
  echo "Cleaning dist/..."
  rm -rf dist
fi
