{
  "name": "@caramba/android",
  "description": "Caramba — Android TV app for Google Chromecast",
  "scripts": {
    "dev": "cd .. && cd web && npm run dev",
    "build": "cd .. && cd web && npm run build",
    "sync": "npx cap sync android",
    "open": "npx cap open android",
    "build:apk": "npx cap build android --release",
    "clean": "npx cap doctor && rm -rf android node_modules"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.3",
    "@capacitor/preferences": "^8.0.1",
    "@caramba/ui": "workspace:*",
    "@jellyfin-rails/player": "workspace:*",
    "@sentry/capacitor": "^4.0.0",
    "@sentry/react": "^10.52.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.3",
    "typescript": "^6.0.3"
  }
}
