#!/usr/bin/env bash
# Start Rails API server + desktop app (Vite + Electron) via foreman.
#
# Foreman doesn't reliably kill the Rails server when Electron exits — Puma gets
# reparented to launchd and the server.pid sticks around, blocking the next run.
# Clean up before start and on exit so a stale puma never wedges the next launch.

cd "$(dirname "$0")/.." || exit 1

PID_FILE="server/tmp/pids/server.pid"

cleanup_rails() {
  [ -f "$PID_FILE" ] || return 0
  local pid
  pid=$(<"$PID_FILE")
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid" 2>/dev/null
    # Wait up to 2s for graceful shutdown before SIGKILL.
    for _ in $(seq 10); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.2
    done
    kill -KILL "$pid" 2>/dev/null
  fi
  rm -f "$PID_FILE"
}

cleanup_rails
trap cleanup_rails EXIT

bin/foreman start -f Procfile.desktop "$@"
