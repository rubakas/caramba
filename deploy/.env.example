# Copy to .env on the NAS host (or wherever you run docker compose).

# Required. Pulled from server/config/master.key on a dev machine; Rails
# uses it to decrypt credentials in production.
RAILS_MASTER_KEY=

# Required. Where your media lives on the NAS host. Mounted read-only at
# /media inside the container — point Caramba MediaFolder rows there.
MEDIA_PATH=/volume1/Media

# Where Caramba keeps its SQLite DBs and HLS transcode segments. Put the
# transcode dir on an NVMe volume if you have one (DXP4800 Pro has 2x M.2).
DATA_PATH=/volume1/docker/caramba

# Host port → container 80 (Thruster is fixed on 80 inside).
CARAMBA_PORT=3000

# Image to pull. Bumped automatically by `bin/build --server --publish`.
CARAMBA_IMAGE=ghcr.io/rubakas/caramba-server:latest

# Render group GID inside the host kernel — must match
#   stat -c '%g' /dev/dri/renderD128
# Common values: UGREEN UGOS = 989, Debian/Ubuntu = 993, Synology = 937.
RENDER_GID=989

# Hardware acceleration. qsv for Intel, vaapi for AMD/Mesa, none to disable.
CARAMBA_HWACCEL=qsv
CARAMBA_VAAPI_DEVICE=/dev/dri/renderD128

# Cap concurrent ffmpeg jobs. i3-1315U (DXP4800 Pro, 8 threads + QSV) → 3.
JELLYFIN_MAX_CONCURRENT_TRANSCODES=3

# Optional. Separate signing secret for HLS tokens. If unset, falls back
# to Rails secret_key_base.
CARAMBA_TOKEN_SECRET=
